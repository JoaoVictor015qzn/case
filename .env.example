# Obrigatório: chave da OpenRouter enviada pelo processo seletivo
OPENROUTER_API_KEY=
# Modelo com suporte a tools + structured_outputs
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Obrigatório: segredo compartilhado entre mcp-server e backend (mínimo 16 caracteres).
# Protege POST /internal/requisicoes, chamado só pela tool criar_requisicao.
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=

# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=compras

# pgAdmin (http://localhost:5050)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Timeouts (segundos)
DUMMYJSON_TIMEOUT_S=5
DUMMYJSON_MAX_ATTEMPTS=3
LLM_TIMEOUT_S=60
